# Google Sheets Credentials (Sử dụng Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account-email@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID="your-spreadsheet-id"

# Cookie của Facebook
# Bạn có thể dùng Extension "EditThisCookie" hoặc "J2TEAM Cookies" trên Chrome để export cookie của Facebook dạng JSON
# Sau đó lưu vào file cookies.json cùng thư mục gốc của bot
FB_COOKIE_PATH="./cookies.json"

# Group IDs hoặc URLs (cách nhau bằng dấu phẩy)
# Ví dụ: https://www.facebook.com/groups/123456789/
TARGET_FB_GROUPS="https://www.facebook.com/groups/samplegroup1/,https://www.facebook.com/groups/samplegroup2/"

# Cấu hình lịch đăng bài (cron syntax)
# Hiện tại cấu hình mặc định là 6h, 12h, 20h
CRON_SCHEDULE="0 6,12,20 * * *"
# Lịch crawl dữ liệu
CRAWL_CRON="0 */8 * * *"
# Lịch xử lý Sheet (tạo content & lọc ảnh) mỗi 12 tiếng
SHEET_PROCESSING_CRON="0 */12 * * *"

# Cookie của Bannha888
BANNHA888_COOKIE="your_bannha888_cookie_here"

# Thiên Khôi API Tokens
# access_token: hết hạn nhanh (~10 phút). Khi hết hạn, hệ thống sẽ tự dùng refresh_token để lấy mới.
THIENKHOI_ACCESS_TOKEN=""
# refresh_token: hạn dài hơn (~12h). Cần cập nhật thủ công khi hết hạn.
THIENKHOI_REFRESH_TOKEN=""

# Gemini API – Pool rotation (rate limit handling)
# Hỗ trợ nhiều key, cách nhau bằng dấu phẩy. Khi hết quota của key này sẽ tự động sang key tiếp.
GEMINI_API_KEYS="your_key_1,your_key_2,your_key_3"
# (Tương thích ngược) Nếu chỉ có 1 key, dùng biến này cũng được:
# GEMINI_API_KEY="your_key_here"

# Danh sách model miễn phí sẽ thử theo thứ tự (rotation khi gặp 429).
# Mặc định đã có sẵn, chỉ set nếu muốn override.
# GEMINI_MODELS="gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash,gemini-3.5-flash,gemini-3.6-flash"

